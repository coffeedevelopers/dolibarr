<?xml version="1.0"?><Report><ReportQuery><Format><ReportTitle>Listado de Stock de Productos</ReportTitle><ReportDescription></ReportDescription><PageSize>.DEFAULT</PageSize><PageOrientation>.DEFAULT</PageOrientation><TopMargin></TopMargin><BottomMargin></BottomMargin><RightMargin></RightMargin><LeftMargin></LeftMargin><pdfFont></pdfFont><pdfFontSize></pdfFontSize><PreExecuteCode>NONE</PreExecuteCode><formBetweenRows>solidline</formBetweenRows><gridDisplay>.DEFAULT</gridDisplay><gridSortable>.DEFAULT</gridSortable><gridSearchable>.DEFAULT</gridSearchable><gridPageable>.DEFAULT</gridPageable><gridPageSize>.DEFAULT</gridPageSize></Format><Datasource><SourceType>database</SourceType><SourceConnection><DatabaseType>mysql</DatabaseType><DatabaseName></DatabaseName><HostName></HostName><ServiceName></ServiceName><UserName></UserName><Password></Password></SourceConnection></Datasource><EntryForm><Query><TableSql></TableSql><WhereSql></WhereSql><GroupSql></GroupSql><RowSelection>all</RowSelection><SQL><QuerySql></QuerySql><SQLRaw>SELECT DISTINCT p.ref as referencia, p.label as Etiqueta,
al.ref as almacen_defecto,
format(p.price,2,'de_DE') as precio_venta, format(p.tva_tx,2,'de_DE') as iva, 
format(p.price_ttc,2,'de_DE') as precio_vta_total, 
p.tosell as para_vender, p.tobuy as para_comprar, p.seuil_stock_alerte as alerta_stock, p.desiredstock as stock_deseado, 
p.stock as stock_fisico, p.stock as stock_virtual,
format(MIN(pfp.unitprice),2,'de_DE') as mejor_precio_compra, ef.eqhoras as equivalencia 
FROM llx_product as p 
LEFT JOIN llx_product_extrafields as ef on (p.rowid = ef.fk_object) 
LEFT JOIN llx_product_fournisseur_price as pfp ON p.rowid = pfp.fk_product
LEFT JOIN llx_entrepot as al ON al.rowid = p.fk_default_warehouse
WHERE p.entity IN (1) AND p.fk_product_type &lt;&gt; 1 
GROUP BY p.ref, p.label, al.ref, p.price, p.tva_tx, p.price_ttc, p.tosell, p.tobuy, p.seuil_stock_alerte, p.desiredstock, p.stock, ef.eqhoras
ORDER BY p.ref</SQLRaw></SQL><QueryColumns><QueryColumn><Name>referencia</Name><TableName></TableName><ColumnName>DISTINCT p.ref as</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title></column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>Etiqueta</Name><TableName></TableName><ColumnName>p.label as</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title></column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>almacen_defecto</Name><TableName></TableName><ColumnName>al.ref as</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title></column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>precio_venta</Name><TableName></TableName><ColumnName>format(p.price,2,'de_DE') as</Col