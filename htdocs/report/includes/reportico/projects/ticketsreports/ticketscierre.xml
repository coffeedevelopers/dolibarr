<?xml version="1.0"?><Report><ReportQuery><Format><ReportTitle>Reporte de Días de Cierre</ReportTitle><ReportDescription></ReportDescription><PageSize>.DEFAULT</PageSize><PageOrientation>.DEFAULT</PageOrientation><TopMargin></TopMargin><BottomMargin></BottomMargin><RightMargin></RightMargin><LeftMargin></LeftMargin><pdfFont></pdfFont><pdfFontSize></pdfFontSize><PreExecuteCode>NONE</PreExecuteCode><formBetweenRows>solidline</formBetweenRows><gridDisplay>.DEFAULT</gridDisplay><gridSortable>.DEFAULT</gridSortable><gridSearchable>.DEFAULT</gridSearchable><gridPageable>.DEFAULT</gridPageable><gridPageSize>.DEFAULT</gridPageSize></Format><Datasource><SourceType>database</SourceType><SourceConnection><DatabaseType>mysql</DatabaseType><DatabaseName></DatabaseName><HostName></HostName><ServiceName></ServiceName><UserName></UserName><Password></Password></SourceConnection></Datasource><EntryForm><Query><TableSql></TableSql><WhereSql></WhereSql><GroupSql></GroupSql><RowSelection>all</RowSelection><SQL><QuerySql></QuerySql><SQLRaw>SELECT 
	t.ref as Ref, 
	CONCAT(u.firstname,' ',u.lastname) as Autor, 
	t.subject as Asunto, 
	ct.label Tipo,
	ts.label as Gravedad,
	s.nom as Tercero,
	t.datec as Fecha,
	CONCAT(u2.firstname,' ',u2.lastname) as Asignado,
	t.date_close as FechaCierre,
	case 
		when fk_statut=0 then 'No leído'
		when fk_statut=1 then 'Leído'
		when fk_statut=2 then 'Asignado'
		when fk_statut=3 then 'En progreso'
		when fk_statut=5 then 'Esperando comentarios'
		when fk_statut=7 then 'En espera'
		when fk_statut=8 then 'Resuelto'
		when fk_statut=9 then 'Cancelado'
	end	as Status,
	case
		when sucursal=1 then 'Bahia Blanca'
		when sucursal=2 then 'Buenos Aires'
		when sucursal=3 then 'Rosario'
	end as Sucursal, 
	case
		when clasificacion=1 then 'Queja o Reclamo de Cliente'
		when clasificacion=2 then 'Desvío'
		when clasificacion=3 then 'Solicitud'
	end as ClasificacionTicket, 
	case
		when clasificacioncierre=1 then 'Observación'
		when clasificacioncierre=2 then 'No conformidad'
		when clasificacioncierre=3 then 'Cerrado'
	end as ClasificacionCierre, 
	case
		when ef.migrado=0 then 'No' 
		when ef.migrado=1 then 'Si' 
	end as Migrado,
	DATEDIFF(t.date_close,t.datec) as CantidadDias	
FROM llx_ticket as t 
LEFT JOIN llx_ticket_extrafields as ef on (t.rowid = ef.fk_object) 
LEFT JOIN llx_societe as s ON (t.fk_soc = s.rowid) 
LEFT JOIN llx_user as u ON (t.fk_user_create = u.rowid) 
LEFT JOIN llx_user as u2 ON (t.fk_user_assign = u2.rowid) 
LEFT JOIN llx_c_ticket_type as ct ON (t.type_code = ct.code)
LEFT JOIN llx_c_ticket_severity as ts ON (t.severity_code = ts.code)
WHERE t.entity IN (1) 
AND NOT ISNULL(t.date_close)
AND NOT ISNULL(t.datec)
[AND Date_format(t.datec,'%Y-%m-%d') between {fechad} and {fechah}]
</SQLRaw></SQL><QueryColumns><QueryColumn><Name>Ref</Name><TableName></TableName><ColumnName>t.ref as</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title></column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>Autor</Name><TableName></TableName><ColumnName>CONCAT(u.firstname,' ',u.lastname) as</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title></column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>Asunto</Name><TableName></TableName><ColumnName>t.subject as</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title></column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>Tipo</Name><TableName>ct</TableName><ColumnName>label</ColumnName><ColumnType>char</ColumnType><Col