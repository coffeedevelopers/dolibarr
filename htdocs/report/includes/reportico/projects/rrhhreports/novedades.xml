<?xml version="1.0"?><Report><ReportQuery><Format><ReportTitle>Listado de Novedades por Fecha</ReportTitle><ReportDescription></ReportDescription><PageSize>.DEFAULT</PageSize><PageOrientation>.DEFAULT</PageOrientation><TopMargin></TopMargin><BottomMargin></BottomMargin><RightMargin></RightMargin><LeftMargin></LeftMargin><pdfFont></pdfFont><pdfFontSize></pdfFontSize><PreExecuteCode>NONE</PreExecuteCode><formBetweenRows>solidline</formBetweenRows><gridDisplay>.DEFAULT</gridDisplay><gridSortable>.DEFAULT</gridSortable><gridSearchable>.DEFAULT</gridSearchable><gridPageable>.DEFAULT</gridPageable><gridPageSize>.DEFAULT</gridPageSize></Format><Datasource><SourceType>database</SourceType><SourceConnection><DatabaseType>mysql</DatabaseType><DatabaseName></DatabaseName><HostName></HostName><ServiceName></ServiceName><UserName></UserName><Password></Password></SourceConnection></Datasource><EntryForm><Query><TableSql></TableSql><WhereSql></WhereSql><GroupSql></GroupSql><RowSelection>all</RowSelection><SQL><QuerySql></QuerySql><SQLRaw>SELECT uue.legajo as legajo,
	CONCAT(uu.firstname, ' ', uu.lastname) As empleado,
	uu.dateemployment as fecha_ingreso,
	cp.rowid as nro_novedad, 
	cp.ref as referencia, 
	nt.label as novedad,
	cp.description as detalle,
	DATE_FORMAT(cp.date_create, &quot;%d-%m-%Y&quot;) as fecha_creacion, 
	DATE_FORMAT(cp.date_debut, &quot;%d-%m-%Y&quot;) as fecha_inicio, 
	DATE_FORMAT(cp.date_fin, &quot;%d-%m-%Y&quot;) as fecha_fin,
    ((cp.date_fin + 1) - cp.date_debut) as dias, 
    cp.date_create as fecha_creacion, 
	CASE cp.statut
         when 1 then 'Borrador'
         when 2 then 'En espera de aprobación'
		 when 3 then 'Aprobada'
		 when 4 then 'Anulada'
		 when 5 then 'Rechazada'
         else 'S/D'
		END AS estado, 
	CONCAT(ua.firstname, ' ', ua.lastname) As validador
FROM llx_holiday as cp
INNER JOIN llx_user as uu ON uu.rowid = cp.fk_user
INNER JOIN llx_user as ua ON ua.rowid = cp.fk_validator
INNER JOIN llx_c_holiday_types as nt ON nt.rowid = cp.fk_type
INNER JOIN llx_user_extrafields as uue ON uue.fk_object = uu.rowid
WHERE cp.entity IN (1)
[AND Date_format(cp.date_debut,'%Y-%m-%d') between {fechad} and {fechah}]
[AND uu.rowid IN {usuario}]</SQLRaw></SQL><QueryColumns><QueryColumn><Name>legajo</Name><TableName></TableName><ColumnName>uue.legajo as</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title></column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>empleado</Name><TableName></TableName><ColumnName>CONCAT(uu.firstname, ' ', uu.lastname) As</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title></column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>fecha_ingreso</Name><TableName></TableName><ColumnName>uu.dateemployment as</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title></column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>nro_novedad</Name><TableName></TableName><