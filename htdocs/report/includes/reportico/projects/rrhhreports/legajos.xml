<?xml version="1.0"?><Report><ReportQuery><Format><ReportTitle>Listado de Legajos</ReportTitle><ReportDescription></ReportDescription><PageSize>.DEFAULT</PageSize><PageOrientation>.DEFAULT</PageOrientation><TopMargin></TopMargin><BottomMargin></BottomMargin><RightMargin></RightMargin><LeftMargin></LeftMargin><pdfFont></pdfFont><pdfFontSize></pdfFontSize><PreExecuteCode>NONE</PreExecuteCode><formBetweenRows>solidline</formBetweenRows><gridDisplay>.DEFAULT</gridDisplay><gridSortable>.DEFAULT</gridSortable><gridSearchable>.DEFAULT</gridSearchable><gridPageable>.DEFAULT</gridPageable><gridPageSize>.DEFAULT</gridPageSize></Format><Datasource><SourceType>database</SourceType><SourceConnection><DatabaseType>mysql</DatabaseType><DatabaseName></DatabaseName><HostName></HostName><ServiceName></ServiceName><UserName></UserName><Password></Password></SourceConnection></Datasource><EntryForm><Query><TableSql></TableSql><WhereSql></WhereSql><GroupSql></GroupSql><RowSelection>all</RowSelection><SQL><QuerySql></QuerySql><SQLRaw>SELECT uue.legajo as legajo,
	CONCAT(uu.firstname, ' ', uu.lastname) As empleado,
	uu.dateemployment as fecha_ingreso,
	CASE uue.categlaboral
         when 1 then 'GERENTE'
         when 2 then 'OFICIAL (JC)'
		 when 3 then 'OFICIAL (JR)'
		 when 4 then 'OFICIAL 1RA (JC)'
		 when 5 then 'OFICIAL 1RA (JR)'
		 when 6 then 'SUPERVISOR'
		 when 7 then 'COORDINADOR A'
		 when 8 then 'COORDINADOR B / OFICIAL ESPECIALIZADO'
		 when 9 then 'COORDINADOR C'
		 when 10 then 'OFICIAL ESPECIALIZADO / VIDRIEROS'
		 when 11 then 'ADMINISTRATIVO A'
		 when 12 then 'ADMINISTRATIVO A (6 HS)'
		 when 13 then 'ADMINISTRATIVO A (4 HS)'
		 when 14 then 'ADMINISTRATIVO B'
		 when 15 then 'ADMINISTRATIVO C'
		 when 16 then 'ADMINISTRATIVO D'
		 when 17 then 'ADMINISTRATIVO E'
		 when 18 then 'ADMINISTRATIVO F'
         else 'S/D'
		END as categoria_laboral,
	edad,
	CASE uue.estadocivil
         when 1 then 'Soltero/a'
         when 2 then 'Casado/a'
		 when 3 then 'Divorciado/a'
		 when 4 then 'Viudo/a'
		 else 'S/D'
		END as estado_civil,
	cuil,
	uue.codobrasocial as codobrasocial,
	CASE uue.modcontratacion
         when 1 then '001 - A TIEMPO PARCIAL INDETERMINADO / TRABAJO PERMANENTE'
         when 2 then '008 - A TIEMPO COMPLETO INDETERMINADO / TRABAJO PERMANENTE'
		 when 3 then '011 - TRABAJO DE TEMPORADA'
		 when 4 then '012 - TRABAJO EVENTUAL'
		 when 5 then '014 - NUEVO PERIODO DE PRUEBA'
		 else 'S/D'
		END as mod_contratacion,
	cedulajuicio,
	actaconciliacion,
	eppadic,
	CASE uue.jornadalaboral
         when 1 then '50 HS'
         when 2 then '75 HS'
		 when 3 then '100 HS'
		 when 4 then '125 HS'
		 when 5 then '150 HS'
		 when 6 then '175 HS'
		 when 7 then '200 HS'
         else 'S/D'
		END as jornada_laboral,
	nacionalidad,
	docdeindentidad as documento_identidad,
	nompadre as nombre_padre,
	nommadre as nombre_madre,
	beneficiarioscvo,
	cedulademanda,
	planillashorarias,
	fotocopiadni,
	constanciacuil,
	certifantecedentes,
	curriculum,
	capacitacionrrhh,
	capacitacionoperac,
	certificadsomedicos,
	certificadotrabajo,
	certificadoanses,
	notificacionjuicio,
	CASE uue.eppnuevo
         when 1 then 'UNIFORME'
         when 2 then 'CALZADO'
		 when 3 then 'GAFAS'
		 when 4 then 'GUANTES'
		 when 5 then 'PROTECTORES AUDITIVOS'
		 when 6 then 'BARBIJO'
		 when 7 then 'MASCARA FACIAL'
		 when 8 then 'CASCO'
		 when 9 then 'CHALECO'
		 when 10 then 'BUZO'
		 when 11 then 'CHAQUETA'
         else 'S/D'
		END as eppnuevo,
	'S/D' as convenio_colectivo
FROM llx_user as uu
LEFT JOIN llx_user_extrafields as uue ON uue.fk_object = uu.rowid
WHERE uu.dateemploymentend is null</SQLRaw></SQL><QueryColumns><QueryColumn><Name>legajo</Name><TableName></TableName><ColumnName>uue.legajo as</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title></column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>empleado</Name><TableName></TableName><ColumnName>CONCAT(uu.firstname, ' ', uu.lastname) As</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title></column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>fecha_ingreso</Name><TableName></TableName><ColumnName>uu.dateemployment as</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title></column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>categoria_laboral</Name><TableName>