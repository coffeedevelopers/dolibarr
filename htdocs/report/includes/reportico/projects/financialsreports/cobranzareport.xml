	(SELECT format(sum(b1.amount),2,'de_DE')
	FROM llx_paiement_facture pf1
	inner join llx_paiement as p1 on p1.rowid = pf1.fk_paiement
	inner join llx_bank as b1 on b1.rowid = p1.fk_bank
	WHERE pf1.fk_facture = fc.rowid
	and b1.fk_account = 6) as RET_IVA_POR_COBRANZAS,
	(SELECT format(sum(b1.amount),2,'de_DE')
	FROM llx_paiement_facture pf1
	inner join llx_paiement as p1 on p1.rowid = pf1.fk_paiement
	inner join llx_bank as b1 on b1.rowid = p1.fk_bank
	WHERE pf1.fk_facture = fc.rowid
	and b1.fk_account = 7) as RET_SUSS,
	(SELECT format(sum(b1.amount),2,'de_DE')
	FROM llx_paiement_facture pf1
	inner join llx_paiement as p1 on p1.rowid = pf1.fk_paiement
	inner join llx_bank as b1 on b1.rowid = p1.fk_bank
	WHERE pf1.fk_facture = fc.rowid
	and b1.fk_account = 8) as RET_IIBB_CABA,
	(SELECT format(sum(b1.amount),2,'de_DE')
	FROM llx_paiement_facture pf1
	inner join llx_paiement as p1 on p1.rowid = pf1.fk_paiement
	inner join llx_bank as b1 on b1.rowid = p1.fk_bank
	WHERE pf1.fk_facture = fc.rowid
	and b1.fk_account = 9) as RET_IIBB_BS_AS,	
	(SELECT format(sum(b1.amount),2,'de_DE')
	FROM llx_paiement_facture pf1
	inner join llx_paiement as p1 on p1.rowid = pf1.fk_paiement
	inner join llx_bank as b1 on b1.rowid = p1.fk_bank
	WHERE pf1.fk_facture = fc.rowid
	and b1.fk_account = 16) as RET_IIBB_STA_FE,
	(SELECT format(sum(b1.amount),2,'de_DE')
	FROM llx_paiement_facture pf1
	inner join llx_paiement as p1 on p1.rowid = pf1.fk_paiement
	inner join llx_bank as b1 on b1.rowid = p1.fk_bank
	WHERE pf1.fk_facture = fc.rowid
	and b1.fk_account = 17) as RET_IIBB_VARIAS,	
	(SELECT format(sum(b1.amount),2,'de_DE')
	FROM llx_paiement_facture pf1
	inner join llx_paiement as p1 on p1.rowid = pf1.fk_paiement
	inner join llx_bank as b1 on b1.rowid = p1.fk_bank
	WHERE pf1.fk_facture = fc.rowid
	and b1.fk_account = 5) as RET_IIBB_SIRCREB,
	(SELECT format(sum(b1.amount),2,'de_DE')
	FROM llx_paiement_facture pf1
	inner join llx_paiement as p1 on p1.rowid = pf1.fk_paiement
	inner join llx_bank as b1 on b1.rowid = p1.fk_bank
	WHERE pf1.fk_facture = fc.rowid
	and b1.fk_account = 4) as RET_GCIAS_COB,	
	(SELECT format(sum(b1.amount),2,'de_DE')
	FROM llx_paiement_facture pf1
	inner join llx_paiement as p1 on p1.rowid = pf1.fk_paiement
	inner join llx_bank as b1 on b1.rowid = p1.fk_bank
	WHERE pf1.fk_facture = fc.rowid
	and (b1.fk_account = 25 OR b1.fk_account = 2 OR b1.fk_account = 23 OR b1.fk_account = 10 OR b1.fk_account = 11 OR b1.fk_account = 12)) as Transferencia,	
	(SELECT format(sum(pf1.amount),2,'de_DE')
	FROM llx_paiement_facture pf1
	inner join llx_paiement as p1 on p1.rowid = pf1.fk_paiement
	inner join llx_bank as b1 on b1.rowid = p1.fk_bank
	WHERE pf1.fk_facture = fc.rowid
	and b1.fk_account = 3) as CH_Importe_Imputado
FROM llx_facture as fc 
INNER JOIN llx_societe as soc ON fc.fk_soc = soc.rowid
LEFT JOIN llx_categorie_societe as cc ON soc.rowid = cc.fk_soc 
LEFT JOIN llx_categorie as cat ON cc.fk_categorie = cat.rowid
WHERE 1= 1
[and Date_format(fc.datef,'%Y-%m-%d') between {fechac} and {fechaf}]
[and cc.fk_categorie = {Region}]
</SQLRaw></SQL><QueryColumns><QueryColumn><Name>Region</Name><TableName></TableName><ColumnName>cat.label as</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title></column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>rowid</Name><TableName>fc</TableName><ColumnName>rowid</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title></column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>Numero</Name><TableName></TableName><ColumnName>fc.ref as</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title></column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>Fecha</Name><TableName></TableName><ColumnName>fc.datef as</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnL