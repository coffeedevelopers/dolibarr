<?xml version="1.0"?><Report><ReportQuery><Format><ReportTitle>Set Report Title</ReportTitle><ReportDescription></ReportDescription><PageSize>.DEFAULT</PageSize><PageOrientation>.DEFAULT</PageOrientation><TopMargin></TopMargin><BottomMargin></BottomMargin><RightMargin></RightMargin><LeftMargin></LeftMargin><pdfFont></pdfFont><pdfFontSize></pdfFontSize><PreExecuteCode>NONE</PreExecuteCode><formBetweenRows>solidline</formBetweenRows><gridDisplay>.DEFAULT</gridDisplay><gridSortable>.DEFAULT</gridSortable><gridSearchable>.DEFAULT</gridSearchable><gridPageable>.DEFAULT</gridPageable><gridPageSize>.DEFAULT</gridPageSize></Format><Datasource><SourceType>database</SourceType><SourceConnection><DatabaseType>mysql</DatabaseType><DatabaseName></DatabaseName><HostName></HostName><ServiceName></ServiceName><UserName></UserName><Password></Password></SourceConnection></Datasource><EntryForm><Query><TableSql></TableSql><WhereSql></WhereSql><GroupSql></GroupSql><RowSelection>all</RowSelection><SQL><QuerySql></QuerySql><SQLRaw>SELECT 
    f.ref AS Referencia,
    f.ref_client AS ReferenciaCliente,
    f.datef AS FechaFacturacion,
    s.nom AS Tercero,
    f.total_ht AS MontoNeto,
    f.total_tva AS MontoImpuesto,
    f.total_ttc AS MontoConImpuesto,
    COALESCE(SUM(pf.amount),0) AS MontoRecibido,
    (f.total_ttc - COALESCE(SUM(pf.amount),0)) AS MontoPendiente,
    CASE f.fk_statut
        WHEN 0 THEN 'Borrador'
        WHEN 1 THEN 'Validada'
        WHEN 2 THEN 'Pagada (parcial o total)'
        WHEN 3 THEN 'Anulada'
        ELSE 'Desconocido'
    END AS Estado
FROM llx_facture f
INNER JOIN llx_societe s ON f.fk_soc = s.rowid
LEFT JOIN llx_paiement_facture pf ON pf.fk_facture = f.rowid
LEFT JOIN llx_paiement p ON p.rowid = pf.fk_paiement
WHERE 1=1
GROUP BY 
    f.rowid, f.ref, f.ref_client, f.datef, s.nom, 
    f.total_ht, f.total_tva, f.total_ttc, f.fk_statut
ORDER BY f.datef DESC;
</SQLRaw></SQL><QueryColumns><QueryColumn><Name>Referencia</Name><TableName></TableName><ColumnName>f.ref AS</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title></column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>ReferenciaCliente</Name><TableName></TableName><ColumnName>f.ref_client AS</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title></column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>FechaFacturacion</Name><TableName></TableName><ColumnName>f.datef AS</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title></column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>Tercero</Name><TableName></TableName><ColumnName>s.nom AS</ColumnName><ColumnType>char</Column