<?xml version="1.0"?><Report><ReportQuery><Format><ReportTitle>IVA Compras</ReportTitle><ReportDescription></ReportDescription><PageSize>.DEFAULT</PageSize><PageOrientation>.DEFAULT</PageOrientation><TopMargin></TopMargin><BottomMargin></BottomMargin><RightMargin></RightMargin><LeftMargin></LeftMargin><pdfFont></pdfFont><pdfFontSize></pdfFontSize><PreExecuteCode>NONE</PreExecuteCode><formBetweenRows>solidline</formBetweenRows><gridDisplay>.DEFAULT</gridDisplay><gridSortable>.DEFAULT</gridSortable><gridSearchable>.DEFAULT</gridSearchable><gridPageable>.DEFAULT</gridPageable><gridPageSize>.DEFAULT</gridPageSize></Format><Datasource><SourceType>database</SourceType><SourceConnection><DatabaseType>mysql</DatabaseType><DatabaseName></DatabaseName><HostName></HostName><ServiceName></ServiceName><UserName></UserName><Password></Password></SourceConnection></Datasource><EntryForm><Query><TableSql></TableSql><WhereSql></WhereSql><GroupSql></GroupSql><RowSelection>all</RowSelection><SQL><QuerySql></QuerySql><SQLRaw>SELECT f.rowid as rowid,
	DATE_FORMAT(f.datef, &quot;%d-%m-%Y&quot;) AS fecha_factura,
    DATE_FORMAT(f.datec, &quot;%d-%m-%Y&quot;) AS fecha_carga,	
	f.ref_supplier AS comprobante,
	s.siren AS CUIT,
	s.nom AS cliente,
	te.libelle AS Condicion_IVA,
	cat.label as Jurisdiccion,
(SELECT format(sum(det_21.total_ht),2,'de_DE') FROM llx_facture_fourn_det as det_21
	where det_21.tva_tx = 21
	and det_21.fk_facture_fourn = f.rowid) as gravado_21,
	(SELECT format(sum(det_105.total_ht),2,'de_DE') FROM llx_facture_fourn_det as det_105
	where det_105.tva_tx = 10.5
	and det_105.fk_facture_fourn = f.rowid) as gravado_105,
	(SELECT format(sum(det_27.total_ht),2,'de_DE') FROM llx_facture_fourn_det as det_27
	where det_27.tva_tx = 27
	and det_27.fk_facture_fourn = f.rowid) as gravado_27,
	(SELECT format(sum(det_0.total_ht),2,'de_DE') FROM llx_facture_fourn_det as det_0
	where det_0.tva_tx = 0
	and det_0.fk_facture_fourn = f.rowid  and det_0.fk_product NOT IN (71, 571,726,727,728,729,115)) as exento,
	(SELECT format(sum(iva_21.tva),2,'de_DE') FROM llx_facture_fourn_det as iva_21
	where iva_21.tva_tx = 21
	and iva_21.fk_facture_fourn = f.rowid) as iva_21,
	(SELECT format(sum(iva_105.tva),2,'de_DE') FROM llx_facture_fourn_det as iva_105
	where iva_105.tva_tx = 10.5
	and iva_105.fk_facture_fourn = f.rowid) as iva_105,
	(SELECT format(sum(iva_27.tva),2,'de_DE') FROM llx_facture_fourn_det as iva_27
	where iva_27.tva_tx = 27
	and iva_27.fk_facture_fourn = f.rowid) as iva_27,
	(SELECT format(sum(iibb_caba.total_ht),2,'de_DE') FROM llx_facture_fourn_det as iibb_caba
		where iibb_caba.fk_product = 71
		and iibb_caba.fk_facture_fourn = f.rowid) as IIBB_CABA,
	(SELECT format(sum(iibb_bsas.total_ht),2,'de_DE') FROM llx_facture_fourn_det as iibb_bsas
		where iibb_bsas.fk_product = 571
		and iibb_bsas.fk_facture_fourn = f.rowid) as IIBB_BSAS,	
	(SELECT format(sum(iibb_chaco.total_ht),2,'de_DE') FROM llx_facture_fourn_det as iibb_chaco
		where iibb_chaco.fk_product = 726
		and iibb_chaco.fk_facture_fourn = f.rowid) as IIBB_CHACO,	
	(SELECT format(sum(iibb_ctes.total_ht),2,'de_DE') FROM llx_facture_fourn_det as iibb_ctes
		where iibb_ctes.fk_product = 727
		and iibb_ctes.fk_facture_fourn = f.rowid) as IIBB_CTES,
	(SELECT format(sum(iibb_sanluis.total_ht),2,'de_DE') FROM llx_facture_fourn_det as iibb_sanluis
		where iibb_sanluis.fk_product = 728
		and iibb_sanluis.fk_facture_fourn = f.rowid) as IIBB_SANLUIS,
	(SELECT format(sum(iibb_neuquen.total_ht),2,'de_DE') FROM llx_facture_fourn_det as iibb_neuquen
		where iibb_neuquen.fk_product = 729
		and iibb_neuquen.fk_facture_fourn = f.rowid) as IIBB_NQN,
	(SELECT format(sum(percep_iva.total_ht),2,'de_DE') FROM llx_facture_fourn_det as percep_iva
		where percep_iva.fk_product = 115
		and percep_iva.fk_facture_fourn = f.rowid) as PERCEP_IVA,	
	format(f.total_ttc,2,'de_DE') as total
FROM llx_facture_fourn AS f
LEFT JOIN llx_societe AS s ON s.rowid = f.fk_soc
LEFT JOIN llx_c_typent as te ON te.id = s.fk_typent
LEFT JOIN llx_categorie_societe cat_det on cat_det.fk_soc = s.rowid
LEFT JOIN llx_categorie cat on cat.rowid = cat_det.fk_categorie
[where Date_format(f.datec,'%Y-%m-%d') between {fechad} and {fechah}]
AND f.fk_statut in (1,2)</SQLRaw></SQL><QueryColumns><QueryColumn><Name>rowid</Name><TableName></TableName><ColumnName>f.rowid as</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title></column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>fecha_factura</Name><TableName></TableName><ColumnName>DATE_FORMAT(f.datef, &quot;%d-%m-%Y&quot;) AS</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title></column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>fecha_carga</Name><TableName></TableName><ColumnName>DATE_FORMAT(f.datec, &quot;%d-%m-%Y&quot;) AS</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title></column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>comprobante</Name