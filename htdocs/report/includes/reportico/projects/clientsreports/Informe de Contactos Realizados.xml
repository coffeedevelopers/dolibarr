<?xml version="1.0"?><Report><ReportQuery><Format><ReportTitle>Informe de Contactos Realizados</ReportTitle><ReportDescription></ReportDescription><PageSize>.DEFAULT</PageSize><PageOrientation>.DEFAULT</PageOrientation><TopMargin></TopMargin><BottomMargin></BottomMargin><RightMargin></RightMargin><LeftMargin></LeftMargin><pdfFont></pdfFont><pdfFontSize></pdfFontSize><PreExecuteCode>NONE</PreExecuteCode><formBetweenRows>solidline</formBetweenRows><gridDisplay>.DEFAULT</gridDisplay><gridSortable>.DEFAULT</gridSortable><gridSearchable>.DEFAULT</gridSearchable><gridPageable>.DEFAULT</gridPageable><gridPageSize>.DEFAULT</gridPageSize></Format><Datasource><SourceType>database</SourceType><SourceConnection><DatabaseType>mysql</DatabaseType><DatabaseName></DatabaseName><HostName></HostName><ServiceName></ServiceName><UserName></UserName><Password></Password></SourceConnection></Datasource><EntryForm><Query><TableSql></TableSql><WhereSql></WhereSql><GroupSql></GroupSql><RowSelection>all</RowSelection><SQL><QuerySql></QuerySql><SQLRaw>select 	llx_user.login, 
		count(llx_actioncomm.id) as cantidad, 
        CASE llx_c_actioncomm.code
		when 'AC_RDV' then 'Cita'
		when 'AC_TEL' then 'Llamada'
		when 'AC_FAX' then 'Envío Fax'
		when 'AC_EMAIL' then 'Envío E-Mail'
		when 'AC_INT' then 'Intervención in situ'
		when 'AC_OTH' then 'Otra'
		when 'AC_OTH_AUTO' then 'Eventos creados automáticamente'
		when 'AC_REG_CONT' then 'Registrar Contacto'
		when 'AC_CONF_RECE' then 'Confirmar Recepción'
		when 'AC_CONT_FUT' then 'Contacto Futuro'
		when 'AC_ENV_COTIZ' then 'Envío de Cotización'
		when 'AC_OF_SERV' then 'Oferta de Servcios'
		when 'AC_PRES_CORP' then 'Presentación Corporativa'
		when 'AC_SEG_LIC' then 'Seguimiento Licitación'
		when 'AC_VAL_COTIZ' then 'Validar Cotización'
	END as tipo_evento,
    llx_categorie.label as categoria_cliente
from llx_actioncomm
inner join llx_user on llx_user.rowid = llx_actioncomm.fk_user_author
inner join llx_c_actioncomm on llx_c_actioncomm.code = llx_actioncomm.code
inner join llx_societe on llx_societe.rowid = llx_actioncomm.fk_soc
inner join llx_categorie_societe on llx_categorie_societe.fk_soc = llx_societe.rowid
inner join llx_categorie on llx_categorie.rowid = llx_categorie_societe.fk_categorie
where llx_actioncomm.code in ('AC_RDV',
'AC_TEL',
'AC_FAX',
'AC_EMAIL',
'AC_INT',
'AC_REG_CONT',
'AC_CONF_RECE',
'AC_CONT_FUT',
'AC_ENV_COTIZ',
'AC_OF_SERV',
'AC_PRES_CORP',
'AC_SEG_LIC',
'AC_VAL_COTIZ')
and llx_categorie.type = 2
and llx_actioncomm.percent = 100
[and Date_format(llx_actioncomm.datep,'%Y-%m-%d') between {fechad} and {fechah}]
group by llx_user.login, llx_c_actioncomm.code, llx_categorie.label
</SQLRaw></SQL><QueryColumns><QueryColumn><Name>login</Name><TableName>llx_user</TableName><ColumnName>login</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title></column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>cantidad</Name><TableName></TableName><ColumnName>count(llx_actioncomm.id) as</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title></column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>tipo_evento</Name><TableName></TableName><ColumnName>CASE llx_c_actioncomm.code
