<?xml version="1.0"?><Report><ReportQuery><Format><ReportTitle>cliente_contratos_activos</ReportTitle><ReportDescription></ReportDescription><PageSize>.DEFAULT</PageSize><PageOrientation>.DEFAULT</PageOrientation><TopMargin></TopMargin><BottomMargin></BottomMargin><RightMargin></RightMargin><LeftMargin></LeftMargin><pdfFont></pdfFont><pdfFontSize></pdfFontSize><PreExecuteCode>NONE</PreExecuteCode><formBetweenRows>solidline</formBetweenRows><gridDisplay>.DEFAULT</gridDisplay><gridSortable>.DEFAULT</gridSortable><gridSearchable>.DEFAULT</gridSearchable><gridPageable>.DEFAULT</gridPageable><gridPageSize>.DEFAULT</gridPageSize></Format><Datasource><SourceType>database</SourceType><SourceConnection><DatabaseType>mysql</DatabaseType><DatabaseName></DatabaseName><HostName></HostName><ServiceName></ServiceName><UserName></UserName><Password></Password></SourceConnection></Datasource><EntryForm><Query><TableSql></TableSql><WhereSql></WhereSql><GroupSql></GroupSql><RowSelection>all</RowSelection><SQL><QuerySql></QuerySql><SQLRaw>-- Reporte principal por cliente
SELECT 
    s.rowid AS cliente_id,
    s.nom AS cliente,
    s.siren AS cuit,
    s.email AS email,
    s.phone AS telefono,
    s.address AS direccion,
    s.town AS plaza,
    GROUP_CONCAT(DISTINCT c.ref ORDER BY c.date_contrat SEPARATOR ', ') AS contratos_activos,
    GROUP_CONCAT(DISTINCT cat.label SEPARATOR ', ') AS categorias,
    MIN(c.date_contrat) AS fecha_primer_contrato,
    MAX(c.date_contrat) AS fecha_ultimo_contrato
FROM llx_societe s
INNER JOIN llx_contrat c ON c.fk_soc = s.rowid
INNER JOIN llx_contratdet cd ON cd.fk_contrat = c.rowid
LEFT JOIN llx_categorie_societe cs ON cs.fk_soc = s.rowid
LEFT JOIN llx_categorie cat ON cat.rowid = cs.fk_categorie
WHERE c.statut = 1
  AND cd.statut = 4
GROUP BY s.rowid, s.nom, s.siren, s.email, s.phone, s.address, s.town
ORDER BY s.nom;

-- Total de clientes
SELECT 
    COUNT(DISTINCT s.rowid) AS total_clientes
FROM llx_societe s
INNER JOIN llx_contrat c ON c.fk_soc = s.rowid
INNER JOIN llx_contratdet cd ON cd.fk_contrat = c.rowid
WHERE c.statut = 1
  AND cd.statut = 4;
</SQLRaw></SQL><QueryColumns><QueryColumn><Name>cliente_id</Name><TableName></TableName><ColumnName>s.rowid AS</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title></column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>cliente</Name><TableName></TableName><ColumnName>s.nom AS</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title></column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>cuit</Name><TableName></TableName><ColumnName>s.siren AS</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title></column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>email</Name><TableName></TableName><ColumnName>s.email AS</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</Colu